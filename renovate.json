{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "prConcurrentLimit": 2,
  "argocd": {
    "managerFilePatterns": [
      "/^src\\/k8s\\/.*\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^src\\/k8s\\/.*\\.ya?ml$/"
    ]
  },
  "enabledManagers": [
    "argocd",
    "kubernetes",
    "kustomize",
    "helm-values"
  ],
  "includePaths": [
    "src/k8s/**"
  ]
}
